<IfModule mod_rewrite.c>
    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteRule ^linguise/linguise.php$ - [L]
    RewriteRule ^(af|sq|am|ar|hy|az|eu|be|bn|bs|bg|ca|ceb|ny|zh-cn|zh-tw|co|hr|cs|da|nl|en|eo|et|tl|fi|fr|fy|gl|ka|de|el|gu|ht|ha|haw|iw|hi|hmn|hu|is|ig|id|ga|it|ja|jw|kn|kk|km|ko|ku|ky|lo|la|lv|lt|lb|mk|mg|ms|ml|mt|mi|mr|mn|my|ne|no|ps|fa|pl|pt|pa|ro|ru|sm|gd|sr|st|sn|sd|si|sk|sl|so|es|su|sw|sv|tg|ta|te|th|tr|uk|ur|uz|vi|cy|xh|yi|yo|zu|zz-zz)(?:$|/)(.*)$ linguise/linguise.php?linguise_language=$1&original_url=$2 [L,QSA]

    # Pastikan sitemap.xml bisa diakses
    RewriteRule ^sitemap\.xml$ - [L]

    # Pastikan rute API Midtrans dapat diakses
    RewriteCond %{REQUEST_URI} ^/api/ [NC]
    RewriteRule ^ - [L]

    # Izinkan akses ke file statis dalam asset dan storage
    RewriteCond %{REQUEST_URI} ^/asset_dashboard/(css|js|img|webfonts)/ [OR]
    RewriteCond %{REQUEST_URI} ^/asset/(lib|css|js|img|webfonts)/ [OR]
    RewriteCond %{REQUEST_URI} ^/storage/img/ [OR]
    RewriteCond %{REQUEST_URI} ^/storage/file/jadwal/
    RewriteRule ^ - [L]

    # Cegah akses ke file sensitif
    RewriteRule ^\.env$ - [F,L]
    RewriteRule ^composer\.(json|lock)$ - [F,L]
    RewriteRule \.(git|svn|htaccess|htpasswd|ini|log|sh|sql|bak|old|swp|swx)$ - [F,L]

    # Blokir akses dengan query string yang mencurigakan (SQL Injection, LFI, dll.)
    RewriteCond %{QUERY_STRING} (\.\./|\.php|%00|%2e%2e) [NC,OR]
    RewriteCond %{QUERY_STRING} (union|select|insert|drop|delete|update|cast|create|truncate|alter|replace) [NC]
    RewriteRule .* - [F,L]

    # Redirect Trailing Slash jika bukan folder
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Redirect semua request yang tidak ditemukan ke Laravel (index.php)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>
<IfModule mod_headers.c>
    Header set Permissions-Policy "geolocation=self"
    Header set Referrer-Policy "no-referrer-when-downgrade"
</IfModule>
